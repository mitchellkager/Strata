# syntax=docker/dockerfile:1
#
# Strata: Qwen3.8-Flash-Next on AMD Radeon cards (docs/AMD_HIP.md): RX 7900 XT / XTX
# (gfx1100) and RX 7800 XT / 7700 XT (gfx1101) by default, the RX 9060 XT (gfx1200)
# and RX 9070 / 9070 XT / Radeon AI PRO R9700 (gfx1201) with HIP_ARCHS, and the RX
# 6800 / 6900 series (gfx1030, unvalidated) with its own.
#
# The engine is compiled during docker build, so the first container start only
# downloads the model (~70 GB) and starts the server. ROCm comes from AMD's
# TheRock Python wheels, pinned the same way setup.py pins it; the wheels hold
# one GPU family's libraries, so one image is built per family (two families in
# one image need a system ROCm, which the wheels do not give):
#
# Build:
#   docker build -f Dockerfile.amd -t strata-amd .                                  # RX 7900 / 7800
#   docker build -f Dockerfile.amd -t strata-amd --build-arg HIP_ARCHS=gfx1101 .    # RX 7800 only (faster)
#   docker build -f Dockerfile.amd -t strata-amd --build-arg HIP_ARCHS=gfx1200,gfx1201 .
#   docker build -f Dockerfile.amd -t strata-amd --build-arg HIP_ARCHS=gfx1030 .
#   Add --build-arg BUILD_VISION=no to skip the image encoder (it runs on the CPU;
#   there is no HIP encoder build yet).
#
# Run (host: Docker and the kernel's amdgpu driver, which stock Linux kernels have;
# no container toolkit is needed for AMD, unlike the NVIDIA image):
#   docker run --rm -p 8080:8080 \
#     --ulimit memlock=-1 \
#     --device /dev/kfd --device /dev/dri \
#     -v strata-data:/data \
#     -e MODEL=IQ2_XS \
#     strata-amd
#
# Setup choices are env vars, read by docker-entrypoint.sh: FAMILY, MODEL, CONTEXT,
# VISION (no | cpu, no GPU encoder yet), KV (int8 | q4_0 | k8v4), GPU (one card,
# numbered as setup lists it) or GPUS ("1,0" or "all", with LAYER_SPLIT), LOW_RAM
# (auto | on | off), HOST, PORT, API_KEY, and BACKEND (hip; setup chooses it by
# itself in an image without NVIDIA).
#
# Only the model files, the prepared pack, the MTP layer and the install config
# live in the /data volume; the engine and ROCm are part of the image. Strata loads
# 32-62 GB into RAM, so a capped container needs -e LOW_RAM=on: setup.py reads the
# RAM from /proc/meminfo, which here is the host's total, not the container's limit.
# Add an API key before exposing the port to a network: -e API_KEY=<secret>. Pass
# -e REINSTALL=1 to change the model settings later.
#
# --device /dev/kfd is what HIP needs to reach the card (plus the /dev/dri render
# nodes); the container runs as root, so the host's render group does not matter.
# --ulimit memlock=-1 lets the engine pin its host memory, as on a normal Linux start.
#
# Several cards of the family: -e GPUS=1,0 splits the model's layers across them
# (the first is the main card, numbers as setup lists them), or -e GPUS=all; pin one
# with -e GPU=0. A split pays only when no single card holds the model's experts.

FROM ubuntu:24.04

# STRATA_EXECV=1: setup.py replaces itself with the server, so the server is PID 1
# and docker stop's SIGTERM reaches it (see setup.start). Normal Linux starts, which
# don't set it, keep spawning the server as a child.
ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 LANG=C.UTF-8 STRATA_EXECV=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git libatomic1 libgomp1 \
        python3 python3-pip python3-venv unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/strata
COPY . .

# One image per GPU family: the family's index is chosen from HIP_ARCHS by setup's
# own mapping (gfx110X-dgpu, gfx120X-all, gfx103X-all), and the wheels are pinned to
# the ROCm version this backend was tested with. BUILD_VISION: cpu | none (the
# image encoder on the CPU, the only encoder the AMD backend has).
ARG HIP_ARCHS=gfx1100,gfx1101
ARG BUILD_VISION=cpu

RUN python3 -m venv .venv \
    && .venv/bin/pip install --no-cache-dir --upgrade pip \
    && .venv/bin/pip install --no-cache-dir -r requirements.txt \
    && chmod +x setup.sh docker-entrypoint.sh

# llama.cpp at the pinned commit, then the engine and the image encoder, built
# exactly the way setup.py builds them: build_engine_hip installs the ROCm wheels
# into .venv (rocm_root, ~10 GB), compiles for the HIP_ARCHS architectures, and
# writes engine/BUILD.json, so the first start reuses the engine instead of
# recompiling.
RUN .venv/bin/python - <<'PYEOF'
import os, setup

archs = [a.strip() for a in os.environ.get("HIP_ARCHS", "gfx1100,gfx1101").split(",") if a.strip()]
vision = "cpu" if os.environ.get("BUILD_VISION", "cpu") == "cpu" else "none"
setup.build_engine_hip({"arch": archs[0], "archs": archs}, setup.get_llama_cpp(), vision)
PYEOF

# the cmake trees are build-time only; the engine itself is what the container needs
RUN rm -rf build-hip build-vision

VOLUME ["/data"]
EXPOSE 8080

# /health is answered before the API key gate, so it works with or without one.
# The port only opens after the model loads (1-3 minutes, longer on a first run),
# so the start period is generous: a too short one marks a still-loading container
# unhealthy and a restart policy would kill it mid-download.
HEALTHCHECK --interval=30s --timeout=5s --start-period=600s --retries=3 \
  CMD curl -fs "http://127.0.0.1:${PORT:-8080}/health" || exit 1

ENTRYPOINT ["./docker-entrypoint.sh"]
